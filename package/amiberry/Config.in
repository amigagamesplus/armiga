config BR2_PACKAGE_AMIBERRY
	bool "amiberry"
	depends on BR2_TOOLCHAIN_HAS_THREADS
	depends on BR2_INSTALL_LIBSTDCPP
	depends on !BR2_STATIC_LIBS
	depends on BR2_aarch64
	select BR2_PACKAGE_SDL3
	select BR2_PACKAGE_FLAC
	select BR2_PACKAGE_LIBPNG
	select BR2_PACKAGE_MPG123
	select BR2_PACKAGE_ZSTD
	select BR2_PACKAGE_LIBCURL
	select BR2_PACKAGE_LIBPCAP
	select BR2_PACKAGE_ENET
	select BR2_PACKAGE_LIBMPEG2
	select BR2_PACKAGE_LIBSERIALPORT
	help
	  Optimized Amiga emulator for ARM with JIT support.
	  Uses SDL3 KMS/DRM backend, OpenGL ES, no X11/Wayland.
	  https://github.com/BlitterStudio/amiberry
