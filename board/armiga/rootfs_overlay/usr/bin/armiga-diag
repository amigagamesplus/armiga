#!/bin/sh
# armiga-diag - genera un informe de diagnostico de ARMIGA en un fichero de texto.
# Guarda el informe en /media/amiga_data/diagnostics/ y escribe su ruta por stdout.
# No incluye contrasenas ni configuracion de WiFi; direcciones MAC e IP se enmascaran.

DIAG_DIR="${ARMIGA_DIAG_DIR:-/media/amiga_data/diagnostics}"
STAMP="$(date +%Y%m%d_%H%M%S)"
OUT="$DIAG_DIR/armiga-diag_$STAMP.txt"

mkdir -p "$DIAG_DIR" 2>/dev/null || { echo "ERROR: no se puede crear $DIAG_DIR" >&2; exit 1; }

# Enmascara direcciones MAC e IPv4
san() {
    sed -E 's/([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}/xx:xx:xx:xx:xx:xx/g; s/([0-9]{1,3}\.){3}[0-9]{1,3}/x.x.x.x/g'
}

section() {
    printf '\n===== %s =====\n' "$1"
}

{
    echo "ARMIGA - informe de diagnostico"
    echo "Generado: $(date '+%Y-%m-%d %H:%M:%S') (uptime $(cut -d' ' -f1 /proc/uptime) s)"

    section "SISTEMA"
    if [ -r /proc/device-tree/model ]; then echo "Modelo: $(tr -d '\0' < /proc/device-tree/model)"; else echo "Modelo: desconocido"; fi
    echo "Kernel: $(uname -r) ($(uname -m))"
    cat /etc/armiga-release 2>/dev/null
    echo "Cmdline: $(cat /proc/cmdline)"

    section "ESTADO"
    for p in /sys/class/power_supply/*; do
        [ -r "$p/type" ] || continue
        echo "Alimentacion $(basename "$p"): tipo=$(cat "$p/type" 2>/dev/null) capacidad=$(cat "$p/capacity" 2>/dev/null) estado=$(cat "$p/status" 2>/dev/null)"
    done
    for z in /sys/class/thermal/thermal_zone*; do
        [ -r "$z/temp" ] || continue
        echo "Temperatura $(cat "$z/type" 2>/dev/null): $(cat "$z/temp" 2>/dev/null) mC"
    done
    echo "Carga: $(cat /proc/loadavg)"
    echo "CPU governor: $(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null) | frecuencia: $(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq 2>/dev/null) kHz"
    echo
    free 2>/dev/null
    echo
    echo "Swap:"
    cat /proc/swaps
    echo
    df -h / /media/amiga_data 2>/dev/null
    echo
    echo "Procesos con mas CPU:"
    top -b -n 1 2>/dev/null | head -14

    section "CONFIGURACION (armiga.cfg)"
    grep -v '^[[:space:]]*$' /media/amiga_data/armiga.cfg 2>/dev/null

    section "PANTALLA Y AUDIO"
    for c in /sys/class/drm/card*-DSI-*; do
        [ -r "$c/modes" ] && echo "$(basename "$c"): $(tr '\n' ' ' < "$c/modes")"
    done
    echo "Brillo: $(cat /sys/class/backlight/backlight/brightness 2>/dev/null) / $(cat /sys/class/backlight/backlight/max_brightness 2>/dev/null)"
    cat /proc/asound/cards 2>/dev/null
    amixer -c 0 sget DAC 2>/dev/null | grep -E "Front Left:|Mono:"

    section "DISPOSITIVOS DE ENTRADA"
    grep -E "^(N:|P:|H:)" /proc/bus/input/devices 2>/dev/null

    section "MODULOS DEL KERNEL"
    lsmod

    section "USB"
    lsusb 2>/dev/null

    section "MONTAJES"
    mount | grep -E "^/dev/|overlay|squashfs"

    section "DMESG"
    dmesg
} 2>&1 | san > "$OUT"

[ -s "$OUT" ] || { echo "ERROR: informe vacio" >&2; exit 1; }
chmod 644 "$OUT" 2>/dev/null
echo "$OUT"
