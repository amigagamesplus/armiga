#!/bin/sh
BATTERY="/sys/class/power_supply/battery"
AC="/sys/class/power_supply/axp20x-usb"

if [ -d "$BATTERY" ]; then
    capacity=$(cat "$BATTERY/capacity" 2>/dev/null)
    status=$(cat "$BATTERY/status" 2>/dev/null)
    echo "Battery 0: $status, $capacity%"
fi

if [ -d "$AC" ]; then
    online=$(cat "$AC/online" 2>/dev/null)
    if [ "$online" = "1" ]; then
        echo "Adapter 0: on-line"
    else
        echo "Adapter 0: off-line"
    fi
fi
