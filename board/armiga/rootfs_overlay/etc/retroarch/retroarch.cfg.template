# retroarch.cfg — ARMIGA (producción)
# Stack: KMS/DRM directo + Panfrost (Mali-G31) + udev input + H700 Gamepad
# Persistente en amiga_data (exFAT, rw) ya que rootfs es ro.

video_driver = "gl"
video_fullscreen = true
video_vsync = true

input_driver = "udev"
input_joypad_driver = "udev"
joypad_autoconfig_dir = "/root/.config/retroarch/autoconfig"

audio_driver = "null"

menu_driver = "ozone"
rgui_show_start_screen = false

# Cores y su .info (commiteados en rootfs_overlay, ro)
libretro_directory = "/usr/lib/libretro"
libretro_info_path = "/usr/lib/libretro"

# Persistencia en amiga_data (exFAT, rw) — sobrevive a reflash de boot+system
system_directory = "/media/amiga_data/kickstarts"
savefile_directory = "/media/amiga_data/retroarch/saves"
savestate_directory = "/media/amiga_data/retroarch/states"
screenshot_directory = "/media/amiga_data/retroarch/screenshots"
rgui_config_directory = "/media/amiga_data/retroarch/config"

# Contenido (ADF/IPF/WHDLoad/HDF) y shaders personalizables del usuario
rgui_browser_directory = "/media/amiga_data/roms"
content_directory = "/media/amiga_data/roms"
video_shader_dir = "/media/amiga_data/shaders"

# Hotkeys H700 (BTN_MODE = b10 = M/F, según CLAUDE.md)
input_enable_hotkey_btn = "10"
input_menu_toggle_btn = "10"
input_exit_emulator_btn = "9"
