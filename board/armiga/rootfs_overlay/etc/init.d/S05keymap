#!/bin/sh
case "$1" in
    start)
        loadkeys es 2>/dev/null || true
        printf 'keycode 114 = VoidSymbol\nkeycode 115 = VoidSymbol\n' | loadkeys -
        ;;
    stop)
        ;;
    restart)
        "$0" start
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac
