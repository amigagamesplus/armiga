#!/bin/sh
# Aplica preferencia de usuario SAMBA_ENABLED (armiga.cfg) tras el arranque
# normal de Samba (S52 y S91smb de Buildroot, que no mira armiga.cfg). Si el
# usuario lo desactivo, lo para aqui; por eso corre despues de S91smb.
CFG="/media/amiga_data/armiga.cfg"
ENABLED=1
if [ -r "$CFG" ]; then
    val=$(grep "^SAMBA_ENABLED=" "$CFG" | cut -d= -f2)
    [ -n "$val" ] && ENABLED="$val"
fi
if [ "$ENABLED" = "0" ]; then
    /etc/init.d/S52samba stop >/dev/null 2>&1
fi
