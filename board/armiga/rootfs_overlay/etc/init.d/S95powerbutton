#!/bin/sh
# S95powerbutton — Apagado limpio al pulsar el botón de encendido
PIDFILE="/var/run/powerbutton.pid"
start() {
    while read -r line; do
        if echo "$line" | grep -q "code 116 (KEY_POWER), value 1"; then
            killall retroarch.real 2>/dev/null || true
            sleep 1
            umount /media/amiga_data 2>/dev/null || true
            echo 0 > /proc/sys/kernel/printk
            poweroff
        fi
    done < <(evtest /dev/input/event0 2>/dev/null) &
    echo $! > "$PIDFILE"
}
case "$1" in
    start) start ;;
    stop)
        [ -f "$PIDFILE" ] && kill $(cat "$PIDFILE") 2>/dev/null || true
        rm -f "$PIDFILE"
        ;;
    restart) "$0" stop; "$0" start ;;
    *) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
