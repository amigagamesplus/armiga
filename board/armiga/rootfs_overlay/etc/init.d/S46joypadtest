#!/bin/sh
# S46joypadtest — carga el driver armiga-joypad de pruebas. Solo actua con
# "armiga_joypad=test" en la linea de arranque; si falla, carga el original.
grep -q "armiga_joypad=test" /proc/cmdline || exit 0
KVER="$(ls /lib/modules | head -1)"
TEST_KO="/media/amiga_data/armiga-joypad.ko"

load_original() {
    rmmod armiga_joypad 2>/dev/null
    insmod "/lib/modules/${KVER}/rocknix-singleadc-joypad.ko" && echo "joypad: driver original cargado"
}

case "$1" in
    start)
        printf "Joypad de pruebas: "
        if [ -f "$TEST_KO" ] && insmod "$TEST_KO" 2>/dev/null \
           && [ -e /sys/bus/platform/drivers/armiga-joypad/rocknix-singleadc-joypad ]; then
            echo "armiga-joypad OK"
        else
            echo "FALLO o sin fichero, usando el driver original"
            load_original
        fi
        ;;
    stop)
        echo "OK"
        ;;
    restart)
        "$0" stop
        "$0" start
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac
