#!/bin/sh
# S05splash — Mostrar splash screen en el framebuffer
case "$1" in
    start)
        if [ -x /usr/bin/armiga-splash ]; then
            /usr/bin/armiga-splash &
            echo $! > /var/run/armiga-splash.pid
        fi
        ;;
    stop|restart)
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac
