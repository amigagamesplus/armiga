#!/bin/sh
# =============================================================================
# S40partitions — Montaje de particiones kickstarts y roms
# =============================================================================
KICKSTARTS_DEV="/dev/mmcblk0p3"
ROMS_DEV="/dev/mmcblk0p4"
KICKSTARTS_MNT="/media/kickstarts"
ROMS_MNT="/media/roms"
EXPAND_FLAG="/var/lib/armiga/.expanded"

do_expand() {
    if [ -f "$EXPAND_FLAG" ]; then
        return 0
    fi

    echo -n "Expanding roms partition... "

    local start_sector
    start_sector=$(cat /sys/block/mmcblk0/mmcblk0p4/start 2>/dev/null)
    if [ -z "$start_sector" ]; then
        echo "SKIP (cannot read start sector)"
        return 1
    fi

    echo "${start_sector}," | sfdisk --no-reread -N 4 /dev/mmcblk0 >/dev/null 2>&1

    partprobe /dev/mmcblk0 2>/dev/null || partx -u /dev/mmcblk0 >/dev/null 2>&1
    sleep 1

    mkfs.exfat -n "roms" "$ROMS_DEV" >/dev/null 2>&1
    mkfs.exfat -n "kickstarts" "$KICKSTARTS_DEV" >/dev/null 2>&1

    mkdir -p "$(dirname "$EXPAND_FLAG")"
    touch "$EXPAND_FLAG"

    echo "OK"
}

case "$1" in
    start)
        printf "Mounting data partitions: "
        mkdir -p "$KICKSTARTS_MNT" "$ROMS_MNT"
        do_expand
        if [ -b "$KICKSTARTS_DEV" ]; then
            mount -t exfat "$KICKSTARTS_DEV" "$KICKSTARTS_MNT" 2>/dev/null && echo -n "kickstarts "
        fi
        if [ -b "$ROMS_DEV" ]; then
            mount -t exfat "$ROMS_DEV" "$ROMS_MNT" 2>/dev/null && echo -n "roms "
        fi
        echo "OK"
        ;;
    stop)
        printf "Unmounting data partitions: "
        umount "$ROMS_MNT" 2>/dev/null || true
        umount "$KICKSTARTS_MNT" 2>/dev/null || true
        echo "OK"
        ;;
    restart)
        "$0" stop
        "$0" start
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac
