#!/bin/sh
# =============================================================================
# S40partitions — Montaje de la partición amiga_data
# Monta p4 (amiga_data, exFAT: kickstarts + roms + configs persistentes)
# En primer arranque, expande p4 al resto de la SD
#
# CAMBIO (esquema A/B):
#   amiga_data pasa de p3 a p4. Motivo: con la nueva particion system_b
#   (p3, slot B del esquema A/B), amiga_data debe seguir siendo la
#   ULTIMA particion fisica del disco — es la unica forma de que el
#   resize al 100% funcione igual en SD de 16GB, 32GB, 64GB o 128GB+,
#   sin necesidad de calcular limites ni reservar tamanos fijos.
#   Orden fisico final: boot(p1) system(p2) system_b(p3) amiga_data(p4).
#
# CAMBIO (versión intermedia particionado):
#   kickstarts + roms fusionadas en una única amiga_data.
#   La expansión SOLO se ejecuta si la partición no ha sido expandida antes
#   (EXPAND_FLAG). A diferencia de la versión anterior, NO se reformatea
#   la partición si ya contiene datos — mkfs.exfat solo se ejecuta la
#   primera vez, justo después del resize, sobre una partición que en ese
#   punto viene recién creada por genimage/post-image.sh y por tanto vacía.
#   En arranques posteriores (tras un reflash de boot+system con flash.sh),
#   EXPAND_FLAG ya no existe en RAM/tmpfs pero la partición física SÍ
#   conserva los datos — por eso NO volvemos a formatear, solo remontamos.
# =============================================================================
AMIGA_DATA_DEV="/dev/mmcblk0p4"
AMIGA_DATA_MNT="/media/amiga_data"
EXPAND_FLAG="/media/amiga_data/.armiga_expanded"

do_expand_if_needed() {
    # SEGURIDAD: nunca confiar solo en EXPAND_FLAG para decidir si formatear.
    # Comprobar si la particion YA tiene un filesystem exfat REAL Y EXPANDIDO
    # via blkid + comparacion de tamanos. No basta con TYPE=exfat: el
    # placeholder que deja genimage en una SD recien flasheada TAMBIEN es
    # exfat valido (256M sin expandir), asi que hay que distinguir por
    # tamano: si el filesystem ocupa una fraccion pequena de la particion,
    # es el placeholder de fabrica (necesita expand+format). Si ocupa casi
    # todo el disco, es una particion de usuario real ya inicializada
    # (jamas volver a formatear, pase lo que pase con el flag).
    if [ -b "$AMIGA_DATA_DEV" ]; then
        FSTYPE=$(blkid -o value -s TYPE "$AMIGA_DATA_DEV" 2>/dev/null)
        if [ "$FSTYPE" = "exfat" ]; then
            PART_SIZE=$(blockdev --getsize64 "$AMIGA_DATA_DEV" 2>/dev/null || echo 0)
            DISK_SIZE=$(blockdev --getsize64 /dev/mmcblk0 2>/dev/null || echo 0)

            # Tamano real del filesystem interior (no de la particion) vía df,
            # montando en modo lectura para no arriesgar nada.
            mkdir -p "$AMIGA_DATA_MNT"
            FS_SIZE_BYTES=0
            if mount -t exfat -o ro "$AMIGA_DATA_DEV" "$AMIGA_DATA_MNT" 2>/dev/null; then
                FS_SIZE_KB=$(df -k "$AMIGA_DATA_MNT" 2>/dev/null | awk 'NR==2{print $2}')
                FS_SIZE_KB=${FS_SIZE_KB:-0}
                FS_SIZE_BYTES=$(( FS_SIZE_KB * 1024 ))
                umount "$AMIGA_DATA_MNT" 2>/dev/null
            fi

            # Umbral 50%: si el filesystem ocupa menos de la mitad de la
            # particion fisica, se considera placeholder de fabrica sin
            # expandir todavia (caso SD recien flasheada por genimage).
            IS_REAL_USER_DATA=0
            if [ "$PART_SIZE" -gt 0 ] 2>/dev/null; then
                HALF_PART=$(( PART_SIZE / 2 ))
                if [ "$FS_SIZE_BYTES" -ge "$HALF_PART" ] 2>/dev/null; then
                    IS_REAL_USER_DATA=1
                fi
            fi

            if [ "$IS_REAL_USER_DATA" = "1" ]; then
                # Particion de usuario real y ya expandida. Solo comprobar
                # si falta ajuste fino de particion vs disco (no reformatear
                # nunca en esta rama).
                NEEDS_EXPAND=0
                if [ "$DISK_SIZE" -gt 0 ] 2>/dev/null; then
                    THRESHOLD=$(( DISK_SIZE * 95 / 100 ))
                    if [ "$PART_SIZE" -lt "$THRESHOLD" ] 2>/dev/null; then
                        NEEDS_EXPAND=1
                    fi
                fi
                if [ "$NEEDS_EXPAND" = "1" ]; then
                    echo -n "Expanding amiga_data partition (no reformat, data preserved)... "
                    parted -s /dev/mmcblk0 resizepart 4 100% >/dev/null 2>&1
                    partprobe /dev/mmcblk0 2>/dev/null || partx -u /dev/mmcblk0 >/dev/null 2>&1
                    sleep 1
                    echo "OK"
                fi
                # Reponer el flag si faltara (p.ej. borrado accidentalmente).
                if mount -t exfat -o rw "$AMIGA_DATA_DEV" "$AMIGA_DATA_MNT" 2>/dev/null; then
                    [ -f "$EXPAND_FLAG" ] || touch "$EXPAND_FLAG"
                    umount "$AMIGA_DATA_MNT" 2>/dev/null
                fi
                return 0
            fi
            # Si no es IS_REAL_USER_DATA, cae al bloque de abajo:
            # placeholder de fabrica, expand+format legitimo.
        fi
    fi

    echo -n "Expanding amiga_data partition (first boot)... "

    # Expandir p4 usando todo el espacio disponible de la SD.
    # Seguro porque amiga_data es SIEMPRE la ultima particion fisica
    # del disco (ver nota de cabecera) — no hay nada despues que pueda
    # ser invadido por este resize, sea cual sea el tamano real de la SD.
    parted -s /dev/mmcblk0 resizepart 4 100% >/dev/null 2>&1

    # Re-leer la tabla de particiones
    partprobe /dev/mmcblk0 2>/dev/null || partx -u /dev/mmcblk0 >/dev/null 2>&1
    sleep 1

    # Formatear SOLO en este primer arranque — la partición recién resized
    # desde la imagen de build está vacía (256M placeholder), así que no
    # hay riesgo de pérdida de datos reales de usuario aquí.
    mkfs.exfat -n "amiga_data" "$AMIGA_DATA_DEV" >/dev/null 2>&1

    mount -t exfat -o noatime "$AMIGA_DATA_DEV" "$AMIGA_DATA_MNT"
    mkdir -p "$AMIGA_DATA_MNT/kickstarts" \
             "$AMIGA_DATA_MNT/roms/adf" "$AMIGA_DATA_MNT/roms/ipf" \
             "$AMIGA_DATA_MNT/roms/whdload" "$AMIGA_DATA_MNT/roms/hdf" \
             "$AMIGA_DATA_MNT/shaders" \
             "$AMIGA_DATA_MNT/retroarch/saves" "$AMIGA_DATA_MNT/retroarch/states" \
             "$AMIGA_DATA_MNT/retroarch/screenshots" "$AMIGA_DATA_MNT/retroarch/config" \
             "$AMIGA_DATA_MNT/retroarch/config/remaps" "$AMIGA_DATA_MNT/retroarch/downloads" \
             "$AMIGA_DATA_MNT/retroarch/playlists" "$AMIGA_DATA_MNT/retroarch/thumbnails" \
             "$AMIGA_DATA_MNT/retroarch/overlays" "$AMIGA_DATA_MNT/retroarch/assets" \
             "$AMIGA_DATA_MNT/retroarch/cheats" "$AMIGA_DATA_MNT/retroarch/records" \
             "$AMIGA_DATA_MNT/retroarch/records_config" "$AMIGA_DATA_MNT/retroarch/config/autoconfig"
    # Comparar version del template con la instalada
    TEMPLATE_VER=$(grep "^# ARMIGA_CFG_VERSION=" /etc/retroarch/retroarch.cfg.template | cut -d= -f2)
    INSTALLED_VER=$(grep "^# ARMIGA_CFG_VERSION=" "$AMIGA_DATA_MNT/retroarch/retroarch.cfg" 2>/dev/null | cut -d= -f2)
    TEMPLATE_VER=${TEMPLATE_VER:-0}
    INSTALLED_VER=${INSTALLED_VER:-0}
    if [ ! -f "$AMIGA_DATA_MNT/retroarch/retroarch.cfg" ] || [ "$TEMPLATE_VER" -gt "$INSTALLED_VER" ]; then
        cp /etc/retroarch/retroarch.cfg.template "$AMIGA_DATA_MNT/retroarch/retroarch.cfg"
    fi
    # Copiar PUAE 2021.opt si no existe, o actualizar si el template es mas nuevo
    mkdir -p "$AMIGA_DATA_MNT/retroarch/config/PUAE 2021"
    PUAE_TEMPLATE_VER=$(grep "^# ARMIGA_CFG_VERSION=" "/etc/retroarch/PUAE 2021.opt" | cut -d= -f2)
    PUAE_INSTALLED_VER=$(grep "^# ARMIGA_CFG_VERSION=" "$AMIGA_DATA_MNT/retroarch/config/PUAE 2021/PUAE 2021.opt" 2>/dev/null | cut -d= -f2)
    PUAE_TEMPLATE_VER=${PUAE_TEMPLATE_VER:-0}
    PUAE_INSTALLED_VER=${PUAE_INSTALLED_VER:-0}
    if [ ! -f "$AMIGA_DATA_MNT/retroarch/config/PUAE 2021/PUAE 2021.opt" ] || [ "$PUAE_TEMPLATE_VER" -gt "$PUAE_INSTALLED_VER" ]; then
        cp "/etc/retroarch/PUAE 2021.opt" "$AMIGA_DATA_MNT/retroarch/config/PUAE 2021/PUAE 2021.opt"
    fi
    # Copiar autoconfig de mando si no existe
    if [ ! -f "$AMIGA_DATA_MNT/retroarch/config/autoconfig/H700 Gamepad.cfg" ]; then
        mkdir -p "$AMIGA_DATA_MNT/retroarch/config/autoconfig"
        cp "/etc/retroarch/autoconfig/H700 Gamepad.cfg" "$AMIGA_DATA_MNT/retroarch/config/autoconfig/H700 Gamepad.cfg"
    fi
    # Copiar Commodore - Amiga.dat (base de datos para renombrado/scraping) si no existe
    if [ ! -f "$AMIGA_DATA_MNT/roms/Commodore - Amiga.dat" ]; then
        cp "/etc/retroarch/Commodore - Amiga.dat" "$AMIGA_DATA_MNT/roms/Commodore - Amiga.dat"
    fi
    # Copiar overrides de nombres de thumbnail (si difieren del nombre canonico del .dat)
    if [ ! -f "$AMIGA_DATA_MNT/roms/amiga_thumbnail_overrides.txt" ]; then
        cp "/etc/retroarch/amiga_thumbnail_overrides.txt" "$AMIGA_DATA_MNT/roms/amiga_thumbnail_overrides.txt"
    fi
    # Crear wifi.conf de ejemplo si no existe
    if [ ! -f "$AMIGA_DATA_MNT/wifi.conf" ]; then
        printf '# Configuracion WiFi de Armiga\n# Edita este fichero con tu red WiFi\nSSID=nombre_de_tu_red\nPASSWORD=tu_contrasena\n'             > "$AMIGA_DATA_MNT/wifi.conf"
    fi
    touch "$EXPAND_FLAG"
    umount "$AMIGA_DATA_MNT"

    echo "OK"
}

case "$1" in
    start)
        printf "Mounting amiga_data partition: "
        mkdir -p "$AMIGA_DATA_MNT"
        do_expand_if_needed
        if [ -b "$AMIGA_DATA_DEV" ]; then
            mount -t exfat -o noatime "$AMIGA_DATA_DEV" "$AMIGA_DATA_MNT" 2>/dev/null && echo -n "amiga_data "
            # Copiar PUAE 2021.opt si falta, o actualizar si el template es mas nuevo (autorreparacion + sync)
            mkdir -p "$AMIGA_DATA_MNT/retroarch/config/PUAE 2021"
            PUAE_TEMPLATE_VER=$(grep "^# ARMIGA_CFG_VERSION=" "/etc/retroarch/PUAE 2021.opt" | cut -d= -f2)
            PUAE_INSTALLED_VER=$(grep "^# ARMIGA_CFG_VERSION=" "$AMIGA_DATA_MNT/retroarch/config/PUAE 2021/PUAE 2021.opt" 2>/dev/null | cut -d= -f2)
            PUAE_TEMPLATE_VER=${PUAE_TEMPLATE_VER:-0}
            PUAE_INSTALLED_VER=${PUAE_INSTALLED_VER:-0}
            if [ ! -f "$AMIGA_DATA_MNT/retroarch/config/PUAE 2021/PUAE 2021.opt" ] || [ "$PUAE_TEMPLATE_VER" -gt "$PUAE_INSTALLED_VER" ]; then
                cp "/etc/retroarch/PUAE 2021.opt" "$AMIGA_DATA_MNT/retroarch/config/PUAE 2021/PUAE 2021.opt"
            fi
            if [ ! -f "$AMIGA_DATA_MNT/retroarch/config/autoconfig/H700 Gamepad.cfg" ]; then
                mkdir -p "$AMIGA_DATA_MNT/retroarch/config/autoconfig"
                cp "/etc/retroarch/autoconfig/H700 Gamepad.cfg" "$AMIGA_DATA_MNT/retroarch/config/autoconfig/H700 Gamepad.cfg"
            fi
            mkdir -p "$AMIGA_DATA_MNT/roms"
            if [ ! -f "$AMIGA_DATA_MNT/roms/Commodore - Amiga.dat" ]; then
                cp "/etc/retroarch/Commodore - Amiga.dat" "$AMIGA_DATA_MNT/roms/Commodore - Amiga.dat"
            fi
            if [ ! -f "$AMIGA_DATA_MNT/roms/amiga_thumbnail_overrides.txt" ]; then
                cp "/etc/retroarch/amiga_thumbnail_overrides.txt" "$AMIGA_DATA_MNT/roms/amiga_thumbnail_overrides.txt"
            fi
            mkdir -p "$AMIGA_DATA_MNT/kickstarts" \
                     "$AMIGA_DATA_MNT/roms/adf" "$AMIGA_DATA_MNT/roms/ipf" \
                     "$AMIGA_DATA_MNT/roms/whdload" "$AMIGA_DATA_MNT/roms/hdf" \
                     "$AMIGA_DATA_MNT/shaders" \
                     "$AMIGA_DATA_MNT/retroarch/saves" "$AMIGA_DATA_MNT/retroarch/states" \
                     "$AMIGA_DATA_MNT/retroarch/screenshots" "$AMIGA_DATA_MNT/retroarch/config" \
                     "$AMIGA_DATA_MNT/retroarch/config/remaps" "$AMIGA_DATA_MNT/retroarch/downloads" \
                     "$AMIGA_DATA_MNT/retroarch/playlists" "$AMIGA_DATA_MNT/retroarch/thumbnails" \
                     "$AMIGA_DATA_MNT/retroarch/overlays" "$AMIGA_DATA_MNT/retroarch/assets" \
                     "$AMIGA_DATA_MNT/retroarch/cheats" "$AMIGA_DATA_MNT/retroarch/records" \
                     "$AMIGA_DATA_MNT/retroarch/records_config" "$AMIGA_DATA_MNT/retroarch/config/autoconfig"
        fi
        echo "OK"
        ;;
    stop)
        printf "Unmounting amiga_data partition: "
        umount "$AMIGA_DATA_MNT" 2>/dev/null || true
        echo "OK"
        ;;
    restart)
        "$0" stop
        "$0" start
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac
