#!/bin/sh
# Aplica preferencia de usuario BT_ENABLED (armiga.cfg) tras el arranque
# normal de S21bluetooth. Si el usuario lo desactivo, lo para aqui.
CFG="/media/amiga_data/armiga.cfg"
ENABLED=1
if [ -r "$CFG" ]; then
    val=$(grep "^BT_ENABLED=" "$CFG" | cut -d= -f2)
    [ -n "$val" ] && ENABLED="$val"
fi
if [ "$ENABLED" = "0" ]; then
    /etc/init.d/S21bluetooth stop >/dev/null 2>&1
fi
