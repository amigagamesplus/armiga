#!/bin/sh
# S43update - Aplica actualizacion OTA pendiente (boot+system unicamente)
# Se ejecuta en arranque, antes del launcher. Preserva amiga_data.

UPDATE_FLAG="/media/amiga_data/update/pending"
UPDATE_IMG_GZ="/media/amiga_data/update/armiga.img.gz"
UPDATE_IMG="/media/amiga_data/update/armiga.img"
LOG="/media/amiga_data/update/update.log"

[ -f "$UPDATE_FLAG" ]   || exit 0
[ -f "$UPDATE_IMG_GZ" ] || { rm -f "$UPDATE_FLAG"; exit 0; }

fb() { echo "$1" > /dev/tty0; echo "$(date): $1" >> "$LOG"; }

printf "\033[2J\033[H\033[32m" > /dev/tty0
fb "  ARMIGA OS"
fb "  Actualizacion del sistema"
fb ""
fb "  No apagues el dispositivo durante este proceso."
fb ""
fb "  [1/3] Descomprimiendo imagen..."

gunzip -c "$UPDATE_IMG_GZ" > "$UPDATE_IMG" 2>> "$LOG"
if [ $? -ne 0 ]; then
    fb "  ERROR al descomprimir. Abortando."
    rm -f "$UPDATE_FLAG" "$UPDATE_IMG"
    exit 1
fi

DEV="/dev/mmcblk0"
if [ ! -b "$DEV" ]; then
    fb "  ERROR: dispositivo no encontrado."
    rm -f "$UPDATE_FLAG" "$UPDATE_IMG"
    exit 1
fi

SFDISK=$(sfdisk -d "$DEV" 2>/dev/null)
P1_START=$(echo "$SFDISK" | grep "${DEV}p1" | grep -o "start=[0-9 ]*" | tr -d " " | cut -d= -f2)
P1_SIZE=$( echo "$SFDISK" | grep "${DEV}p1" | grep -o "size=[0-9 ]*"  | tr -d " " | cut -d= -f2)
P2_START=$(echo "$SFDISK" | grep "${DEV}p2" | grep -o "start=[0-9 ]*" | tr -d " " | cut -d= -f2)
P2_SIZE=$( echo "$SFDISK" | grep "${DEV}p2" | grep -o "size=[0-9 ]*"  | tr -d " " | cut -d= -f2)

if [ -z "$P1_START" ] || [ -z "$P2_SIZE" ]; then
    fb "  ERROR: no se pudieron leer offsets de particiones."
    rm -f "$UPDATE_FLAG" "$UPDATE_IMG"
    exit 1
fi

P1_SKIP_BYTES=$(( P1_START * 512 ))
P1_COUNT_BYTES=$(( P1_SIZE  * 512 ))
P2_SKIP_BYTES=$(( P2_START * 512 ))
P2_COUNT_BYTES=$(( P2_SIZE  * 512 ))

fb "  [2/3] Flasheando particion boot..."
dd if="$UPDATE_IMG" of="$DEV" bs=4M \
   iflag=skip_bytes,count_bytes oflag=seek_bytes \
   skip=$P1_SKIP_BYTES count=$P1_COUNT_BYTES seek=$P1_SKIP_BYTES \
   conv=fsync 2>> "$LOG"
if [ $? -ne 0 ]; then
    fb "  ERROR al flashear boot."
    rm -f "$UPDATE_FLAG" "$UPDATE_IMG"
    exit 1
fi

fb "  [3/3] Flasheando particion sistema (~3 min)..."
dd if="$UPDATE_IMG" of="$DEV" bs=4M \
   iflag=skip_bytes,count_bytes oflag=seek_bytes \
   skip=$P2_SKIP_BYTES count=$P2_COUNT_BYTES seek=$P2_SKIP_BYTES \
   conv=fsync 2>> "$LOG"
if [ $? -ne 0 ]; then
    fb "  ERROR al flashear sistema."
    rm -f "$UPDATE_FLAG" "$UPDATE_IMG"
    exit 1
fi

fb "  Actualizacion completada. Reiniciando..."
rm -f "$UPDATE_FLAG" "$UPDATE_IMG_GZ" "$UPDATE_IMG" "/media/amiga_data/update/armiga.img.gz.sha256"
sync
reboot
