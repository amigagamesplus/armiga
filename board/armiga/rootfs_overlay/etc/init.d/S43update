#!/bin/sh
# S43update - Aplica actualizacion OTA pendiente (esquema A/B)
# Se ejecuta en arranque, antes del launcher. Preserva amiga_data.
#
# ESQUEMA A/B:
#   - system  (p2) = armiga-a
#   - system_b(p3) = armiga-b
#   - Se flashea SIEMPRE la particion INACTIVA (nunca la que esta
#     montada como / en este arranque). Al terminar, se actualiza
#     DEFAULT en extlinux.conf (p1) para apuntar al slot recien
#     flasheado, y se reinicia.
#   - Si el nuevo slot falla al arrancar, el slot anterior sigue
#     intacto: basta con revertir DEFAULT manualmente (o via futuro
#     mecanismo de rollback) para volver atras.

UPDATE_FLAG="/media/amiga_data/update/pending"
UPDATE_IMG_GZ="/media/amiga_data/update/armiga.img.gz"
UPDATE_IMG="/media/amiga_data/update/armiga.img"
LOG="/media/amiga_data/update/update.log"
BOOT_DEV="/dev/mmcblk0p1"
BOOT_MNT="/tmp/boot_ota"
DEV="/dev/mmcblk0"

[ -f "$UPDATE_FLAG" ]   || exit 0
[ -f "$UPDATE_IMG_GZ" ] || { rm -f "$UPDATE_FLAG"; exit 0; }

log() { echo "$(date): $1" >> "$LOG"; }
t() { [ "$IS_EN" = "1" ] && echo "$2" || echo "$1"; }

UI_LANG=$(grep '^LANG=' /media/amiga_data/armiga.cfg 2>/dev/null | cut -d= -f2)
[ "$UI_LANG" = "EN" ] && IS_EN=1 || IS_EN=0

ESC=$(printf '\033')
C_G="${ESC}[32m"; C_Y="${ESC}[33m"; C_R="${ESC}[31m"; C_W="${ESC}[37m"; C_N="${ESC}[0m"
EL="${ESC}[K"
BAR="============================================"
SEP="--------------------------------------------"
S1=0; S2=0; S3=0; S4=0; CUR=0
MSG_C="$C_W"; MSG1=""; MSG2=""; MSG3=""
START_UP=$(cut -d' ' -f1 /proc/uptime | cut -d. -f1)

pl() { printf '%s%s\n' "$1" "$EL"; }

mark() {
    case "$1" in
        1) printf '%s[ .. ]%s' "$C_Y" "$C_N" ;;
        2) printf '%s[ OK ]%s' "$C_G" "$C_N" ;;
        3) printf '%s[FAIL]%s' "$C_R" "$C_N" ;;
        *) printf '[    ]' ;;
    esac
}

render() {
    NOW_UP=$(cut -d' ' -f1 /proc/uptime | cut -d. -f1)
    ES=$(( NOW_UP - START_UP ))
    ET=$(printf '%02d:%02d' $(( ES / 60 )) $(( ES % 60 )))
    {
        printf '%s[H' "$ESC"
        pl "${C_G} ${BAR}${C_N}"
        pl "${C_G}   ARMIGA                   $(t "Actualizacion" "Update")${C_N}"
        pl "${C_G} ${BAR}${C_N}"
        pl ""
        pl "${C_W}   $(t "No apagues el dispositivo." "Do not power off the device.")${C_N}"
        pl ""
        pl "${C_W}   $(t "Slot activo : " "Active slot : ")${ACTIVE_LABEL}${C_N}"
        pl "${C_W}   $(t "Slot destino: " "Target slot : ")${TARGET_LABEL}${C_N}"
        pl ""
        pl "   $(mark $S1) 1/4  $(t "Descomprimiendo imagen" "Decompressing image")"
        pl "   $(mark $S2) 2/4  $(t "Flasheando $TARGET_LABEL (~3 min)" "Flashing $TARGET_LABEL (~3 min)")"
        pl "   $(mark $S3) 3/4  $(t "Configuracion de arranque" "Boot configuration")"
        pl "   $(mark $S4) 4/4  $(t "Finalizando" "Finishing")"
        pl ""
        pl "${C_W} ${SEP}${C_N}"
        pl "${C_W}   $(t "Tiempo transcurrido" "Elapsed time"): ${ET}${C_N}"
        pl ""
        pl "${MSG_C}   ${MSG1}${C_N}"
        pl "${MSG_C}   ${MSG2}${C_N}"
        pl "${MSG_C}   ${MSG3}${C_N}"
        printf '%s[J' "$ESC"
    } > /dev/tty0
}

cleanup_fail() {
    log "$1"
    umount "$BOOT_MNT" 2>/dev/null
    [ -n "$LOOP_DEV" ] && losetup -d "$LOOP_DEV" 2>/dev/null
    rm -f "$UPDATE_FLAG" "$UPDATE_IMG"
    case "$CUR" in 1) S1=3 ;; 2) S2=3 ;; 3) S3=3 ;; 4) S4=3 ;; esac
    MSG_C="$C_R"
    MSG1="$1"
    MSG2="$(t "El sistema actual no se ha modificado." "The current system has not been modified.")"
    MSG3="$(t "Continuando el arranque en 10 s..." "Continuing boot in 10 s...")"
    render
    sleep 10
    printf '%s[?25h' "$ESC" > /dev/tty0
    exit 1
}

printf '%s[2J%s[?25l' "$ESC" "$ESC" > /dev/tty0
render

# --- Determinar slot activo actual vía /proc/cmdline ------------------------
CURRENT_ROOT=$(grep -o 'root=/dev/mmcblk0p[0-9]*' /proc/cmdline | cut -d= -f2)
case "$CURRENT_ROOT" in
    /dev/mmcblk0p2)
        ACTIVE_LABEL="armiga-a"
        TARGET_PART="${DEV}p3"
        TARGET_LABEL="armiga-b"
        ;;
    /dev/mmcblk0p3)
        ACTIVE_LABEL="armiga-b"
        TARGET_PART="${DEV}p2"
        TARGET_LABEL="armiga-a"
        ;;
    *)
        cleanup_fail "$(t "ERROR: no se pudo determinar el slot activo ($CURRENT_ROOT)." "ERROR: could not determine active slot ($CURRENT_ROOT).")"
        ;;
esac
log "slot: $ACTIVE_LABEL -> $TARGET_LABEL"

# --- Descomprimir imagen -----------------------------------------------------
CUR=1; S1=1; render; log "[1/4] decompressing image"
gunzip -c "$UPDATE_IMG_GZ" > "$UPDATE_IMG" 2>> "$LOG"
if [ $? -ne 0 ]; then
    cleanup_fail "$(t "ERROR al descomprimir. Abortando." "ERROR while decompressing. Aborting.")"
fi
S1=2; CUR=2; S2=1; render

if [ ! -b "$DEV" ]; then
    cleanup_fail "$(t "ERROR: dispositivo no encontrado." "ERROR: device not found.")"
fi

# --- Leer offsets de la particion SYSTEM (p2) dentro de la imagen -----------
# La imagen .img siempre trae system en p2 (build normal). Esa es la
# porcion de bytes que copiamos hacia el slot inactivo, sea cual sea
# su numero de particion real en el dispositivo (p2 o p3).
# ROBUSTEZ: en vez de parsear el texto de "sfdisk -d" (fragil ante
# cambios de formato entre versiones), se monta la imagen como loop
# device con -P (particiones expuestas) y se leen los offsets/tamanos
# directamente de sysfs, que son valores numericos puros sin parsing.
LOOP_DEV=$(losetup -f)
if [ -z "$LOOP_DEV" ]; then
    cleanup_fail "$(t "ERROR: no se pudo obtener un loop device libre." "ERROR: could not get a free loop device.")"
fi
losetup -P "$LOOP_DEV" "$UPDATE_IMG" 2>> "$LOG"
if [ $? -ne 0 ]; then
    cleanup_fail "$(t "ERROR: no se pudo asociar la imagen a $LOOP_DEV." "ERROR: could not attach image to $LOOP_DEV.")"
fi
LOOP_NAME=$(basename "$LOOP_DEV")

IMG_P2_START=$(cat "/sys/class/block/${LOOP_NAME}p2/start" 2>/dev/null)
IMG_P2_SIZE=$(cat "/sys/class/block/${LOOP_NAME}p2/size" 2>/dev/null)

if [ -z "$IMG_P2_START" ] || [ -z "$IMG_P2_SIZE" ]; then
    losetup -d "$LOOP_DEV" 2>/dev/null
    cleanup_fail "$(t "ERROR: no se pudieron leer offsets de la imagen origen (sysfs)." "ERROR: could not read source image offsets (sysfs).")"
fi

IMG_P2_SKIP_BYTES=$(( IMG_P2_START * 512 ))
IMG_P2_COUNT_BYTES=$(( IMG_P2_SIZE  * 512 ))

# --- Leer offset del slot INACTIVO en el dispositivo real -------------------
# Mismo mecanismo: sysfs en vez de parsear "sfdisk -d" del dispositivo.
TARGET_PNAME=$(basename "$TARGET_PART")
DEV_START=$(cat "/sys/class/block/${TARGET_PNAME}/start" 2>/dev/null)

if [ -z "$DEV_START" ]; then
    losetup -d "$LOOP_DEV" 2>/dev/null
    cleanup_fail "$(t "ERROR: no se pudo leer el offset del slot inactivo ($TARGET_PART, sysfs)." "ERROR: could not read inactive slot offset ($TARGET_PART, sysfs).")"
fi

DEV_SEEK_BYTES=$(( DEV_START * 512 ))

# --- Flashear SOLO la particion inactiva -------------------------------------
# IMPORTANTE: $TARGET_PART nunca esta montada en este momento (es el
# slot inactivo), por lo que este dd es seguro sin necesidad de
# desmontar nada ni salir del rootfs activo.
log "[2/4] flashing $TARGET_LABEL"
dd if="$UPDATE_IMG" of="$DEV" bs=4M \
   iflag=skip_bytes,count_bytes oflag=seek_bytes \
   skip=$IMG_P2_SKIP_BYTES count=$IMG_P2_COUNT_BYTES seek=$DEV_SEEK_BYTES \
   conv=fsync 2>> "$LOG" &
DD_PID=$!
while kill -0 "$DD_PID" 2>/dev/null; do
    render
    sleep 1
done
wait "$DD_PID"
DD_RESULT=$?
losetup -d "$LOOP_DEV" 2>/dev/null
if [ "$DD_RESULT" -ne 0 ]; then
    cleanup_fail "$(t "ERROR al flashear el slot inactivo." "ERROR while flashing inactive slot.")"
fi

# --- Actualizar DEFAULT en extlinux.conf (p1) --------------------------------
S2=2; CUR=3; S3=1; render; log "[3/4] updating boot configuration"
mkdir -p "$BOOT_MNT"
mount "$BOOT_DEV" "$BOOT_MNT" 2>> "$LOG"
if [ $? -ne 0 ]; then
    cleanup_fail "$(t "ERROR: no se pudo montar la particion de arranque." "ERROR: could not mount boot partition.")"
fi

EXTLINUX_CONF="$BOOT_MNT/extlinux/extlinux.conf"
if [ ! -f "$EXTLINUX_CONF" ]; then
    cleanup_fail "$(t "ERROR: extlinux.conf no encontrado en boot." "ERROR: extlinux.conf not found in boot.")"
fi

sed -i "s/^DEFAULT .*/DEFAULT $TARGET_LABEL/" "$EXTLINUX_CONF"
sync
umount "$BOOT_MNT"

# --- Limpieza y reinicio ------------------------------------------------------
S3=2; CUR=4; S4=1; render; log "[4/4] update complete"
rm -f "$UPDATE_FLAG" "$UPDATE_IMG_GZ" "$UPDATE_IMG" "/media/amiga_data/update/armiga.img.gz.sha256"
sync
S4=2
MSG_C="$C_G"
MSG1="$(t "Actualizacion completada." "Update complete.")"
MSG2="$(t "Reiniciando a $TARGET_LABEL en 5 s..." "Rebooting to $TARGET_LABEL in 5 s...")"
render
sleep 5
printf '%s[?25h' "$ESC" > /dev/tty0
reboot
