#!/bin/sh
# =============================================================================
# S30dropbear — SSH server (Dropbear)
# =============================================================================

DROPBEAR_ARGS="-R -p 22"
PID_FILE="/var/run/dropbear.pid"

case "$1" in
    start)
        printf "Starting Dropbear SSH: "

        # Generar host keys si no existen
        if [ ! -f /etc/dropbear/dropbear_rsa_host_key ]; then
            dropbearkey -t rsa -f /etc/dropbear/dropbear_rsa_host_key > /dev/null 2>&1
        fi
        if [ ! -f /etc/dropbear/dropbear_ed25519_host_key ]; then
            dropbearkey -t ed25519 -f /etc/dropbear/dropbear_ed25519_host_key > /dev/null 2>&1
        fi

        dropbear $DROPBEAR_ARGS -P "$PID_FILE"
        echo "OK"
        ;;
    stop)
        printf "Stopping Dropbear SSH: "
        if [ -f "$PID_FILE" ]; then
            kill "$(cat "$PID_FILE")" 2>/dev/null
            rm -f "$PID_FILE"
        fi
        echo "OK"
        ;;
    restart)
        "$0" stop
        sleep 1
        "$0" start
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac
