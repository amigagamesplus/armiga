#!/bin/sh
# Aplica preferencia de usuario SSH_ENABLED (armiga.cfg) tras el arranque
# normal de dropbear (S50). Si el usuario lo desactivo, lo para aqui.
CFG="/media/amiga_data/armiga.cfg"
ENABLED=1
if [ -r "$CFG" ]; then
    val=$(grep "^SSH_ENABLED=" "$CFG" | cut -d= -f2)
    [ -n "$val" ] && ENABLED="$val"
fi
if [ "$ENABLED" = "0" ]; then
    /etc/init.d/S50dropbear stop >/dev/null 2>&1
fi
