# =============================================================================
# Armiga — /etc/fstab
# rootfs y boot montados ro (inmunidad ante cortes de energía).
# Volátiles redirigidos a tmpfs. amiga_data es la única partición rw física.
# =============================================================================

# <device>              <mountpoint>     <type>   <options>                          <dump> <pass>
/dev/mmcblk0p2          /                ext4     ro,noatime                          0      1

# amiga_data: montada explícitamente por S40partitions (necesita lógica de
# expansión en primer arranque), no aquí directamente. Se deja comentada
# como referencia.
# /dev/mmcblk0p3        /media/amiga_data exfat   rw,noatime,uid=0,gid=0,umask=000    0      0

# --- Volátiles en RAM (rootfs es ro, esto NO escribe en la SD) -------------
tmpfs                   /var/log         tmpfs    defaults,noatime,mode=0755,size=16M 0      0
tmpfs                   /var/lib         tmpfs    defaults,noatime,mode=0755,size=8M  0      0
tmpfs                   /var/run         tmpfs    defaults,noatime,mode=0755,size=4M  0      0
tmpfs                   /var/tmp         tmpfs    defaults,noatime,mode=1777,size=16M 0      0
tmpfs                   /tmp             tmpfs    defaults,noatime,mode=1777,size=32M 0      0
tmpfs                   /run             tmpfs    defaults,noatime,mode=0755,size=8M  0      0

proc                    /proc            proc     defaults                            0      0
sysfs                   /sys             sysfs    defaults                            0      0
devtmpfs                /dev             devtmpfs defaults                            0      0
devpts                  /dev/pts         devpts   defaults,gid=5,mode=620              0      0
