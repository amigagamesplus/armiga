# BusyBox extras for Armiga Fase 1
# Enable udhcpc (DHCP client)
CONFIG_UDHCPC=y
CONFIG_FEATURE_UDHCPC_ARPING=y
CONFIG_UDHCPC_DEFAULT_SCRIPT="/usr/share/udhcpc/default.script"

# Enable rfkill (for WiFi/BT control)
CONFIG_RFKILL=y

# Enable loadkmap (for keyboard layout)
CONFIG_LOADKMAP=y
# Enable ntpd (sincronizacion de hora via NTP, lanzado por S42ntp)
CONFIG_NTPD=y
CONFIG_FEATURE_NTPD_SERVER=n
CONFIG_FEATURE_NTPD_CONF=n
CONFIG_FEATURE_NTP_AUTH=n
