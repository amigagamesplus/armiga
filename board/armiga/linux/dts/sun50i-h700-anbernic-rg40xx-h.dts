#include "sun50i-h700-anbernic-rg35xx-plus.dts"

/ {
	model = "Anbernic RG40XX H";
	compatible = "anbernic,rg40xx-h", "allwinner,sun50i-h700";
	rocknix-dt-id = "sun50i-h700-anbernic-rg40xx-h";

	joypad: rocknix-singleadc-joypad {
		compatible = "rocknix-singleadc-joypad";
		hw_info = <0x01>;
		joypad-name = "H700 Gamepad";
		joypad-product = <0x14DF>;
		joypad-revision = <0x0100>;
		joypad-vendor = <0x484B>;
		status = "okay";
		pwms = <&pwm 3 1000000 0>;
		pwm-names = "enable";
		rumble-boost-weak = <0>;
		rumble-boost-strong = <0>;
		pinctrl-names = "default";
		pinctrl-0 = <&joy_mux_pin>, <&pwm3_pin>;
		io-channel-names = "amux_adc";
		io-channels = <&gpadc 0>;
		amux-count = <4>;
		amux-channel-mapping = <0 2 1 3>;
		amux-a-gpios = <&pio 8 1 GPIO_ACTIVE_LOW>;
		amux-b-gpios = <&pio 8 2 GPIO_ACTIVE_LOW>;
		button-adc-scale = <36>;
		button-adc-deadzone = <2304>;
		button-adc-fuzz = <32>;
		button-adc-flat = <32>;
		abs_x-p-tuning = <70>;
		abs_x-n-tuning = <70>;
		invert-absx;
		abs_y-p-tuning = <70>;
		abs_y-n-tuning = <70>;
		invert-absy;
		abs_rx-p-tuning = <70>;
		abs_rx-n-tuning = <70>;
		invert-absrx;
		abs_ry-p-tuning = <70>;
		abs_ry-n-tuning = <70>;
		invert-absry;
		poll-interval = <10>;
		sw1 {
			gpios = <&pio 0 6 GPIO_ACTIVE_LOW>;
			label = "GPIO DPAD-UP";
			linux,code = <KEY_RESERVED>;
			rocknix,dpad-hat = <1>;
			gpio-active-low;
		};
		sw2 {
			gpios = <&pio 4 0 GPIO_ACTIVE_LOW>;
			label = "GPIO DPAD-DOWN";
			linux,code = <KEY_RESERVED>;
			rocknix,dpad-hat = <2>;
			gpio-active-low;
		};
		sw3 {
			gpios = <&pio 0 8 GPIO_ACTIVE_LOW>;
			label = "GPIO DPAD-LEFT";
			linux,code = <KEY_RESERVED>;
			rocknix,dpad-hat = <3>;
			gpio-active-low;
		};
		sw4 {
			gpios = <&pio 0 9 GPIO_ACTIVE_LOW>;
			label = "GPIO DPAD-RIGHT";
			linux,code = <KEY_RESERVED>;
			rocknix,dpad-hat = <4>;
			gpio-active-low;
		};
		sw5 {
			gpios = <&pio 0 0 GPIO_ACTIVE_LOW>;
			label = "GPIO BTN-A";
			linux,code = <BTN_EAST>;
		};
		sw6 {
			gpios = <&pio 0 1 GPIO_ACTIVE_LOW>;
			label = "GPIO BTN-B";
			linux,code = <BTN_SOUTH>;
		};
		sw7 {
			gpios = <&pio 0 3 GPIO_ACTIVE_LOW>;
			label = "GPIO BTN-X";
			linux,code = <BTN_WEST>;
		};
		sw8 {
			gpios = <&pio 0 2 GPIO_ACTIVE_LOW>;
			label = "GPIO BTN-Y";
			linux,code = <BTN_NORTH>;
		};
		sw9 {
			gpios = <&pio 0 5 GPIO_ACTIVE_LOW>;
			label = "BTN_SELECT";
			linux,code = <BTN_SELECT>;
		};
		sw10 {
			gpios = <&pio 0 4 GPIO_ACTIVE_LOW>;
			label = "BTN_START";
			linux,code = <BTN_START>;
		};
		sw11 {
			gpios = <&pio 4 3 GPIO_ACTIVE_LOW>;
			label = "GPIO BTN_F";
			linux,code = <BTN_MODE>;
		};
		sw12 {
			gpios = <&pio 4 8 GPIO_ACTIVE_LOW>;
			label = "BTN_THUMBL";
			linux,code = <BTN_THUMBL>;
		};
		sw13 {
			gpios = <&pio 4 9 GPIO_ACTIVE_LOW>;
			label = "BTN_THUMBR";
			linux,code = <BTN_THUMBR>;
		};
		sw14 {
			gpios = <&pio 0 12 GPIO_ACTIVE_LOW>;
			label = "GPIO BTN_TR";
			linux,code = <BTN_TR>;
		};
		sw15 {
			gpios = <&pio 0 7 GPIO_ACTIVE_LOW>;
			label = "GPIO BTN_TR2";
			linux,code = <BTN_TR2>;
		};
		sw16 {
			gpios = <&pio 0 10 GPIO_ACTIVE_LOW>;
			label = "GPIO BTN_TL";
			linux,code = <BTN_TL>;
		};
		sw17 {
			gpios = <&pio 0 11 GPIO_ACTIVE_LOW>;
			label = "GPIO BTN_TL2";
			linux,code = <BTN_TL2>;
		};
	};
};

&uart5 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart5_ph_pins>;
	status = "okay";
};

&leds {
	led-rgb {
		function = LED_FUNCTION_KBD_BACKLIGHT;
		color = <LED_COLOR_ID_RGB>;
		gpios = <&pio 8 7 GPIO_ACTIVE_HIGH>;
	};
};

&panel {
	compatible = "anbernic,rg40xx-panel", "panel-mipi-dpi-spi";
};

&mmc1 {
	vmmc-supply = <&reg_cldo4>;
	vqmmc-supply = <&reg_aldo4>;
	mmc-pwrseq = <&wifi_pwrseq>;
	bus-width = <4>;
	non-removable;
	status = "okay";
	wifi@1 {
		reg = <1>;
		interrupt-parent = <&pio>;
		interrupts = <6 15 IRQ_TYPE_LEVEL_LOW>;
		interrupt-names = "host-wake";
	};
};

&gpadc {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";
	channel@0 {
		reg = <0>;
	};
};
